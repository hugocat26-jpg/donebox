{
  "name": "donebox",
  "productName": "DoneBox",
  "version": "1.0.0",
  "description": "Lightweight desktop todo list app",
  "main": "./out/main/index.js",
  "author": "example.com",
  "homepage": "https://electron-vite.org",
  "scripts": {
    "dev": "npm run build:app && node scripts/run-local-runtime.mjs",
    "start": "npm run dev",
    "dev:electron": "electron-vite dev",
    "build:app": "electron-vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && npm run typecheck",
    "verify:app": "node scripts/verify-app.mjs",
    "build": "npm run test && npm run build:app && npm run verify:app && electron-builder --dir",
    "dist": "npm run test && npm run build:app && npm run verify:app && electron-builder --win portable"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "chrono-node": "^2.9.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "framer-motion": "^12.38.0",
    "localforage": "^1.10.0",
    "lucide-react": "^1.8.0",
    "lunar-javascript": "^1.7.7",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-markdown": "^9.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.5.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@types/node": "^25.0.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.22",
    "electron": "^42.4.0",
    "electron-builder": "^26.15.2",
    "electron-vite": "^4.0.1",
    "playwright": "^1.60.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^7.2.7",
    "vitest": "^4.0.15"
  },
  "build": {
    "appId": "com.electron",
    "productName": "DoneBox",
    "asar": false,
    "electronDist": "node_modules/electron/dist",
    "electronVersion": "42.4.0",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "resources/**/*",
      "package.json"
    ],
    "win": {
      "icon": "resources/icon.png",
      "executableName": "donebox",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "DoneBox-portable-${version}.${ext}"
    }
  }
}
